# Sprite OpenAI Connector URL: include the connector ID and end with /v1.
OPENAI_BASE_URL=https://api.sprites.dev/v1/gateway/openai/<connector-id>/v1
# Placeholder required by the connector gateway; Fly injects the real key.
OPENAI_API_KEY=sprites
OPENAI_MODEL=gpt-5-mini

# Local direct OpenAI usage instead:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=<your-openai-project-key>

# Fly.io Tavily Connector gateway URL, ending in /tavily/<connector-id> (no /search suffix).
# Do not put your Tavily account API key here; Fly injects it through the Connector.
TAVILY_BASE_URL=

SERVER_PORT=8080
