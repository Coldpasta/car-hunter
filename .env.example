# In a Fly.io Sprite, use the OpenAI Connector gateway. Leave OPENAI_API_KEY unset.
OPENAI_BASE_URL=https://api.sprites.dev/v1/gateway/openai
OPENAI_MODEL=gpt-5-mini
# Local development only: use https://api.openai.com and your own project key.
# OPENAI_API_KEY=

# Fly.io Tavily Connector gateway URL, ending in /tavily/<connector-id> (no /search suffix).
# Do not put your Tavily account API key here; Fly injects it through the Connector.
TAVILY_BASE_URL=

SERVER_PORT=8080
